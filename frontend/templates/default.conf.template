# Resolve the backend host at request time rather than once at nginx startup.
# NGINX_LOCAL_RESOLVERS is set by the base image's own
# docker-entrypoint.d/15-local-resolvers.envsh from the container's
# /etc/resolv.conf. Without this, proxy_pass with a static hostname is
# resolved once when nginx boots — on Railway that hostname
# (<service>.railway.internal) may not exist yet at that exact moment (first
# deploy, or backend mid-restart), which crashes nginx outright ("host not
# found in upstream") instead of just failing the individual request.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Always open, no auth — this is what Docker's own HEALTHCHECK and any
    # external uptime monitor hit, and it returns nothing but {"status":"ok"}.
    # docker-entrypoint.d/20-basic-auth.sh writes basic-auth.conf; without an
    # explicit "auth_basic off" here this location would inherit whatever it
    # sets below and healthchecks would start failing with 401.
    location = /api/health {
        auth_basic off;
        # No path after $backend: with a variable, that means "no URI"
        # rewriting, so nginx forwards the original request URI (already
        # /api/health) unchanged — see the comment on the /api/ block below.
        set $backend http://${AURUM_BACKEND_HOST}:${AURUM_BACKEND_PORT};
        proxy_pass $backend;
        proxy_set_header Host $host;
    }

    # Reverse proxy to the FastAPI backend container. AURUM_BACKEND_HOST/PORT
    # default to docker-compose's "backend:8000" (see Dockerfile ENV) but are
    # overridable per-environment — e.g. on Railway, where the backend lives
    # at <service-name>.railway.internal instead of a fixed compose DNS name.
    # This file is a template rendered by nginx's own envsubst entrypoint step
    # (/docker-entrypoint.d/20-envsubst-on-templates.sh), which only touches
    # names that exist as real environment variables — nginx's own $uri/$host/
    # etc. below aren't env vars, so they pass through untouched.
    # basic-auth.conf is generated at container start (empty if
    # AURUM_BASIC_AUTH_USER/PASSWORD aren't set, so this is a no-op by
    # default) — see docker-entrypoint.d/.
    location /api/ {
        include /etc/nginx/basic-auth.conf;
        # $backend deliberately carries no path: per nginx docs, a proxy_pass
        # value with no URI after the host:port passes the client's original
        # request URI through unchanged. A static trailing "/api/" here would
        # be fine too (it equals the location prefix, a no-op rewrite) — but
        # that rewriting only applies to a *static* proxy_pass string. With a
        # variable, nginx skips the rewrite and appends the trailing path
        # literally instead, which would double it into "/api//api/...".
        set $backend http://${AURUM_BACKEND_HOST}:${AURUM_BACKEND_PORT};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA fallback — client-side routing handles the rest. Deliberately NOT
    # behind auth_basic: this is just the built HTML/JS/CSS shell, no
    # financial data lives in it. The app's own branded login screen
    # (frontend/src/components/auth/LoginGate.tsx) is what actually gates
    # entry, by requiring a valid Authorization header on every /api/ call
    # above — the real protection stays exactly where it was.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
